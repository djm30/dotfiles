{
  "$schema": "./extensions/pi-permission-system/schemas/permissions.schema.json",
  "defaultPolicy": {
    "tools": "allow",
    "bash": "allow",
    "mcp": "allow",
    "skills": "allow",
    "special": "ask"
  },
  "tools": {
    "read": "allow",
    "grep": "allow",
    "find": "allow",
    "ls": "allow",
    "write": "allow",
    "edit": "allow",
    "bash": "allow",
    "mcp": "allow",
    "task": "allow",
    "ask_user": "allow",
    "todo": "allow",
    "ketch_search": "allow",
    "ketch_scrape": "allow",
    "ketch_code": "allow",
    "ketch_docs": "allow",
    "ketch_crawl": "allow",
    "codemode": "allow"
  },
  "bash": {
    "git status": "allow",
    "git status *": "allow",
    "git diff": "allow",
    "git diff *": "allow",
    "git log": "allow",
    "git log *": "allow",
    "git branch --show-current": "allow",
    "ls": "allow",
    "ls *": "allow",
    "ls -la": "allow",
    "pwd": "allow",
    "whoami": "allow",
    "id": "allow",
    "date": "allow",
    "uname": "allow",
    "env": "allow",
    "git branch": "allow",
    "git remote -v": "allow",
    "git show": "allow",
    "git diff --stat": "allow",
    "git status --short": "allow",
    "git log --oneline": "allow",
    "cat": "allow",
    "head": "allow",
    "tail": "allow",
    "grep *": "allow",
    "read *": "allow",
    "wc": "allow",
    "file": "allow",
    "tree": "allow",
    "rm *": "allow",
    "rm -rf *": "allow",
    "git reset --hard *": "deny",
    "git clean *": "deny",
    "git checkout -- *": "deny",
    "git restore *": "deny"
  },
  "skills": {
    "*": "allow",
    "dangerous-*": "deny"
  },
  "special": {
    "external_directory": "ask",
    "external_directory:/Users/n1646868/.pi/*": "allow",
    "external_directory:/tmp/*": "allow",
    "doom_loop": "allow"
  }
}
