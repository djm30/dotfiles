# Pi coding agent (~/.pi/agent). Only hand-written config is tracked.
# Not tracked: auth/mcp-auth/models-store (secrets), sessions, install/, npm/,
# mcp.json (work MCP servers), orca-*.ts extensions (generated by Orca).
$DOTFILES/pi/settings.json=$HOME/.pi/agent/settings.json
$DOTFILES/pi/pi-permissions.jsonc=$HOME/.pi/agent/pi-permissions.jsonc
$DOTFILES/pi/APPEND_SYSTEM.md=$HOME/.pi/agent/APPEND_SYSTEM.md
$DOTFILES/pi/extensions/exit-alias.ts=$HOME/.pi/agent/extensions/exit-alias.ts
$DOTFILES/pi/skills/review-pr=$HOME/.pi/agent/skills/review-pr
