[[ "$TERM_PROGRAM" == "vscode" ]] && . "$(code --locate-shell-integration-path zsh)"

if test -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"; then
    source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Repo root, worked out from this file's real location (~/.zshrc is a symlink).
export DOTFILES="${${(%):-%x}:A:h:h}"

# Keep PATH entries unique however many times they are added.
typeset -U path PATH

# Machine-local, untracked settings (secrets, work config).
[[ -r "$HOME/.env.sh" ]] && source "$HOME/.env.sh"

# Plugin manager. Installed by install/setup.sh, not on shell startup.
if [[ -r "$HOME/.local/share/zap/zap.zsh" ]]; then
    source "$HOME/.local/share/zap/zap.zsh"

    plug "$DOTFILES/zsh/aliases.zsh"
    plug "$DOTFILES/zsh/commands.zsh"
    plug "$DOTFILES/zsh/exports.zsh"
    plug "$DOTFILES/zsh/p10k.zsh"

    plug "zsh-users/zsh-autosuggestions"
    plug "zsh-users/zsh-syntax-highlighting"
    plug "zap-zsh/supercharge"
    plug "jeffreytse/zsh-vi-mode"
    plug "zap-zsh/fzf"
    plug "romkatv/powerlevel10k"
else
    print -u2 "zap not installed; run $DOTFILES/install/setup.sh"
    source "$DOTFILES/zsh/aliases.zsh"
    source "$DOTFILES/zsh/commands.zsh"
    source "$DOTFILES/zsh/exports.zsh"
fi

autoload -Uz compinit
compinit

# Fallback for non-login shells that skipped ~/.zprofile.
: "${HOMEBREW_PREFIX:=/opt/homebrew}"

# Node (nvm)
export NVM_DIR="$HOME/.nvm"
[[ -s "$HOMEBREW_PREFIX/opt/nvm/nvm.sh" ]] && source "$HOMEBREW_PREFIX/opt/nvm/nvm.sh"

# Python (pyenv)
export PYENV_ROOT="$HOME/.pyenv"
[[ -d "$PYENV_ROOT/bin" ]] && path=("$PYENV_ROOT/bin" $path)
(( $+commands[pyenv] )) && eval "$(pyenv init - zsh)"

# Java 21 (fixed path: `brew --prefix` on every shell start is slow)
if [[ -d "$HOMEBREW_PREFIX/opt/openjdk@21" ]]; then
    export JAVA_HOME="$HOMEBREW_PREFIX/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home"
    path=("$JAVA_HOME/bin" $path)
fi

# opencode
path=("$HOME/.opencode/bin" $path)

# Personal scripts (awsl etc.) win over everything else.
path=("$HOME/.local/bin" $path)
